{
  "name": "dsh-workproof",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.js scripts/compatibility.test.mjs",
    "test:host": "node --test scripts/*host-smoke.mjs",
    "test:release": "node --test scripts/check-release.test.mjs",
    "check": "node --check packages/dsh-delivery-receipts/index.js && node --check packages/dsh-delivery-receipts/client.js && node --check packages/dsh-evidence-ledger/index.js && node --check packages/dsh-evidence-ledger/client.js",
    "test:compatibility": "node --test scripts/compatibility.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2"
  }
}
